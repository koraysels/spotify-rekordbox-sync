# ---------------------------------------------------------------------------
# Kopieer naar .env en vul in.  cp .env.example .env
#
# COMPOSE_PROFILES bepaalt wat er draait. Zet alleen de apps aan waarvoor je
# hierboven ook echt credentials hebt ingevuld — een profiel met lege vars
# start een container die meteen crasht.
# ---------------------------------------------------------------------------

COMPOSE_PROFILES=honeygain,earnapp,traffmonetizer

# Naam waaronder dit apparaat in de dashboards verschijnt.
DEVICE_NAME=komodo-server

# --- Honeygain -------------------------------------------------------------
HONEYGAIN_EMAIL=
HONEYGAIN_PASSWORD=

# --- EarnApp ---------------------------------------------------------------
# ./scripts/gen-earnapp-uuid.sh genereert een geldige waarde
EARNAPP_UUID=

# --- Traffmonetizer --------------------------------------------------------
TRAFFMONETIZER_TOKEN=

# --- Repocket --------------------------------------------------------------
REPOCKET_EMAIL=
REPOCKET_API_KEY=

# --- IPRoyal Pawns ---------------------------------------------------------
PAWNS_EMAIL=
PAWNS_PASSWORD=

# --- PacketStream ----------------------------------------------------------
PACKETSTREAM_CID=

# --- EarnFM ----------------------------------------------------------------
EARNFM_TOKEN=

# --- Proxyrack -------------------------------------------------------------
PROXYRACK_UUID=
PROXYRACK_API_KEY=
