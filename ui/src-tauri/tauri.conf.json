{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rbsync",
  "version": "0.2.2",
  "identifier": "be.cursorpointer.rbsync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Spotify to Rekordbox Sync",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/rbsync-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4ODQxM0JCNjA2NzExODUKUldTRkVXZGd1eE9FU0tvSThZWXdXQ1ZLZDNpZW5jUksrN3VOMnQ2U1NGdFdpU1lVRVVQVW1SdXAK",
      "endpoints": [
        "https://github.com/koraysels/spotify-rekordbox-sync/releases/latest/download/latest.json"
      ]
    }
  }
}
